# Keep the build context small and the image CODE-ONLY. The Dockerfile copies only what it needs
# (requirements.txt, pyproject.toml, README.md, LICENSE, src/); this is defense-in-depth so secrets
# and local config can never enter the image even if a COPY is broadened later.

# VCS / tooling / caches
.git
.gitignore
.github
.venv
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store

# Secrets & per-developer config -- must NEVER enter the image.
secrets/
config/

# Local working dirs, outputs, scratch
logs/
tmp/
scripts/

# Not needed at runtime
tests/
docs/
context/
